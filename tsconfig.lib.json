{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@kicad-io/*": ["../kicad-io/src/*"],
			"@kicad-model/*": ["../kicad-model/*"]
		}
	},
	"include": [
		"index.ts",
		"KicadRenderSession.ts",
		"math/**/*.ts",
		"paint/**/*.ts",
		"render/**/*.ts",
		"text/**/*.ts",
		"connectivity/**/*.ts",
		"PathUtils.ts",
		"SheetTree.ts",
		"RegisterDefaultClasses.ts"
	]
}
